<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/autopilot_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

  <ImageView
      android:id="@+id/widget_icon"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:contentDescription="Autopilot"
      android:src="@drawable/ic_autopilot_stat"
      android:tint="#FF818CF8" />

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Autopilot"
        android:textColor="#FFECEDEF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text=""
        android:textColor="#FF9EA4AE"
        android:textSize="12.5sp" />
  </LinearLayout>

  <TextView
      android:id="@+id/widget_toggle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:background="@drawable/autopilot_widget_button"
      android:paddingStart="12dp"
      android:paddingTop="8dp"
      android:paddingEnd="12dp"
      android:paddingBottom="8dp"
      android:text="Pause 1 h"
      android:textColor="#FF818CF8"
      android:textSize="13sp"
      android:textStyle="bold" />
</LinearLayout>
